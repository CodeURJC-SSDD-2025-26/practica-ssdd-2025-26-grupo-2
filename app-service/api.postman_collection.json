    {
      "name": "IndexRestController",
      "description": "Peticiones para probar los mappings de IndexRestController.",
      "item": [
        {
          "name": "Obtener index - /api/v1/pages",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Respuesta 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"Devuelve las claves esperadas\", function () {",
                  "    pm.expect(json).to.have.property(\"viajesNuevos\");",
                  "    pm.expect(json).to.have.property(\"viajesPopulares\");",
                  "    pm.expect(json).to.have.property(\"nombresAnimados\");",
                  "    pm.expect(json).to.have.property(\"reviews\");",
                  "});",
                  "",
                  "pm.test(\"Las listas principales son arrays\", function () {",
                  "    pm.expect(json.viajesNuevos).to.be.an(\"array\");",
                  "    pm.expect(json.viajesPopulares).to.be.an(\"array\");",
                  "    pm.expect(json.reviews).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }

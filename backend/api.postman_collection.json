    {
      "name": "GlobalRestController",
      "description": "Peticiones para probar los atributos globales expuestos por GlobalRestController.",
      "item": [
        {
          "name": "Obtener atributos globales - /api/v1/global",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Respuesta 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"Devuelve las claves esperadas\", function () {",
                  "    pm.expect(json).to.have.property(\"viajes\");",
                  "    pm.expect(json).to.have.property(\"logged\");",
                  "});",
                  "",
                  "pm.test(\"viajes es array\", function () {",
                  "    pm.expect(json.viajes).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"logged es booleano\", function () {",
                  "    pm.expect(json.logged).to.be.a(\"boolean\");",
                  "});",
                  "",
                  "pm.test(\"Si hay viajes, tienen las claves esperadas\", function () {",
                  "    if (json.viajes.length > 0) {",
                  "        pm.expect(json.viajes[0]).to.include.all.keys(",
                  "            \"id\",",
                  "            \"nombre\",",
                  "            \"descripcion\",",
                  "            \"pais\",",
                  "            \"precio\",",
                  "            \"transporte\",",
                  "            \"alojamiento\",",
                  "            \"fechaInicio\",",
                  "            \"fechaFin\",",
                  "            \"maxPlazas\",",
                  "            \"numNoches\",",
                  "            \"tieneImagen\"",
                  "        );",
                  "    }",
                  "});",
                  "",
                  "pm.test(\"Si esta autenticado, devuelve datos de usuario\", function () {",
                  "    if (json.logged) {",
                  "        pm.expect(json).to.have.property(\"userName\");",
                  "        pm.expect(json).to.have.property(\"admin\");",
                  "        pm.expect(json.admin).to.be.a(\"boolean\");",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://localhost:8443/api/v1/global",
              "protocol": "https",
              "host": ["localhost"],
              "port": "8443",
              "path": ["api", "v1", "global"]
            }
          },
          "response": []
        },

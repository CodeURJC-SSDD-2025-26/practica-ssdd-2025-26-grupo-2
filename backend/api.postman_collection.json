    {
      "name": "Buscar viajes (Filtros)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Respuesta exitosa (200 o 204)\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/travels/search?country=Francia&daterange=05/01/2026 - 05/30/2026&travelers=2",
          "protocol": "https",
          "host": ["localhost"],
          "port": "8443",
          "path": ["api", "v1", "travels", "search"],
          "query": [
            { "key": "country", "value": "Francia" },
            { "key": "daterange", "value": "05/01/2026 - 05/30/2026" },
            { "key": "travelers", "value": "2" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Crear nuevo viaje (Admin)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
        },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"nombre\": \"Aventura en los Alpes\",\n    \"pais\": \"Francia\",\n    \"precio\": 1200,\n    \"viajeros\": 4\n}"
        },
        "url": {
